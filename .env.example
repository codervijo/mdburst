# .env.example — copy to .env (gitignored) and fill in real values.
# Document each env var below with a one-line comment about what it does.
#
# For production, set these in the Cloudflare project's environment-variable
# settings rather than here — they are inlined at build time.

# GA4 measurement ID. Astro only exposes vars prefixed PUBLIC_ to client code,
# so this is the one the analytics loader reads first. Leave it unset to
# disable analytics entirely: src/analytics/init.ts no-ops when it is missing,
# blank, or still the G-XXXXXXXXXX sample below.
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Legacy alias, read as a fallback so this project matches the sibling Vite
# sites that use VITE_GA_ID. Prefer PUBLIC_GA_ID for new setups.
# VITE_GA_ID=
