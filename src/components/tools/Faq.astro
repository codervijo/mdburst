---
// Visible FAQ, rendered from the same array that feeds the FAQPage JSON-LD in
// ToolLayout. Google requires the marked-up Q&A to be present on the page for
// users; sharing one source is what guarantees that stays true.
//
// Uses <details>/<summary> so answers are collapsible with zero JavaScript and
// keyboard-operable by default. The answer text is in the DOM either way, so
// collapsing costs nothing for indexing.
import type { FaqEntry } from "../../data/tools";

interface Props {
  faqs: FaqEntry[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="mx-auto max-w-3xl px-6 py-10 sm:py-12">
  <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
    Frequently asked questions
  </h2>

  <div class="mt-6 divide-y divide-border border-y border-border">
    {
      faqs.map((faq) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-sm font-medium text-foreground marker:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            <span>{faq.question}</span>
            <span
              aria-hidden="true"
              class="mt-0.5 shrink-0 text-muted-foreground transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>
