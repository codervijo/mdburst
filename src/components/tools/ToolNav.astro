---
// Server-rendered chrome for /tools/* pages.
//
// The landing page's <Nav> is a React island whose links are same-page anchors
// (#features, #pricing); those are meaningless off the homepage. This is a
// plain static nav with absolute links — no JS, no hydration cost, and the
// links are in the initial HTML where crawlers can follow them.
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight" aria-label="mdburst home">
      <span
        aria-hidden="true"
        class="grid h-7 w-7 place-items-center rounded-lg bg-foreground text-xs font-bold text-background"
      >md</span>
      <span>mdburst</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 text-sm text-muted-foreground md:flex">
      <a href="/tools/" class="transition-colors hover:text-foreground">Tools</a>
      <a href="/#how" class="transition-colors hover:text-foreground">How it works</a>
      <a href="/#features" class="transition-colors hover:text-foreground">Features</a>
      <a href="/#pricing" class="transition-colors hover:text-foreground">Pricing</a>
    </nav>

    <a
      href="/#waitlist"
      class="inline-flex h-8 items-center justify-center rounded-full bg-primary px-4 text-xs font-medium text-primary-foreground transition-colors hover:bg-primary/90"
    >
      Join waitlist
    </a>
  </div>
</header>
